{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/irasikhin/sandboxer/main/schema/config.schema.json",
  "$defs": {
    "ImageSpec": {
      "properties": {
        "extraPkgs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nix": {
          "type": "string"
        },
        "llmAgentsRev": {
          "type": "string"
        },
        "nixpkgsRev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Limits": {
      "properties": {
        "memory": {
          "type": "string"
        },
        "cpus": {
          "type": "string"
        },
        "pids": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Mount": {
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "target"
      ]
    },
    "Network": {
      "properties": {
        "allowedDomains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Profile": {
      "properties": {
        "name": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/Network"
        },
        "proxy": {
          "type": "string"
        },
        "noProxy": {
          "type": "string"
        },
        "agents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "egress": {
          "type": "boolean"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extraMounts": {
          "items": {
            "$ref": "#/$defs/Mount"
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "setup": {
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "image": {
          "$ref": "#/$defs/ImageSpec"
        },
        "mcp": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "schemaDocument": {
      "properties": {
        "defaults": {
          "$ref": "#/$defs/Profile"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/Profile"
          },
          "type": "object"
        },
        "default": {
          "type": "string"
        },
        "agentProxy": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Profile"
    },
    {
      "$ref": "#/$defs/schemaDocument"
    }
  ],
  "title": "sandboxer profile",
  "description": "A sandboxer .sandboxer/config.yaml: either a single flat profile or a document with defaults:/profiles:."
}
