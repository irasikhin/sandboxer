{
  "claude": {
    "bin": "claude",
    "authEnv": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_BASE_URL"],
    "nixPackage": "claude-code",
    "resume": ["claude", "--continue"],
    "resumePick": ["claude", "--resume"],
    "seed": [
      { "path": ".claude", "skip": [".credentials.json", "projects", "todos", "statsig", "shell-snapshots", "downloads", "cache"] },
      { "path": ".claude.json" }
    ]
  },
  "codex": {
    "bin": "codex",
    "authEnv": ["OPENAI_API_KEY", "CODEX_API_KEY"],
    "nixPackage": "codex",
    "image": false,
    "resume": ["codex", "resume", "--last"],
    "resumePick": ["codex", "resume"],
    "seed": [
      { "path": ".codex", "skip": ["sessions", "log", "history.jsonl"] }
    ]
  },
  "opencode": {
    "bin": "opencode",
    "authEnv": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY", "OPENROUTER_API_KEY", "DEEPSEEK_API_KEY"],
    "nixPackage": "opencode",
    "resume": ["opencode", "--continue"],
    "seed": [
      { "path": ".config/opencode" },
      { "path": ".local/share/opencode/auth.json" }
    ]
  },
  "crush": {
    "bin": "crush",
    "authEnv": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GROQ_API_KEY", "OPENROUTER_API_KEY"],
    "nixPackage": "crush",
    "resume": ["crush", "--continue"],
    "seed": [
      { "path": ".config/crush" }
    ]
  },
  "pi": {
    "bin": "pi",
    "authEnv": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "DEEPSEEK_API_KEY"],
    "nixPackage": "pi",
    "resume": ["pi", "--continue"],
    "resumePick": ["pi", "--resume"],
    "seed": [
      { "path": ".pi/agent", "skip": ["auth.json", "sessions", "pi-debug.log", "npm", "git"] }
    ]
  },
  "gemini": {
    "bin": "gemini",
    "authEnv": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
    "nixPackage": "gemini-cli",
    "seed": [
      { "path": ".gemini", "skip": ["tmp"] }
    ]
  },
  "dsh": {
    "bin": "dsh",
    "authEnv": ["DEEPSEEK_API_KEY", "DEEPSEEK_BASE_URL"],
    "nixPackage": "dsh",
    "seed": [
      { "path": ".dsh", "skip": ["sessions", "storages", "profiles/node_modules"] }
    ]
  }
}
